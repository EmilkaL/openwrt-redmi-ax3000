table inet ra80vpn {
	set static4 {
		type ipv4_addr
		flags interval
		auto-merge
	}

	set dns4 {
		type ipv4_addr
	}

	set local4 {
		type ipv4_addr
		flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
	}

	chain select {
		type filter hook prerouting priority -151; policy accept;
		iifname "br-lan" ip daddr @local4 return
		iifname "br-lan" ip daddr @static4 meta mark set meta mark | 0x00200000
		iifname "br-lan" ip daddr @dns4 meta mark set meta mark | 0x00200000
	}

	chain resolver {
		type route hook output priority -151; policy accept;
		ip daddr { 9.9.9.9, 149.112.112.112 } meta l4proto { tcp, udp } th dport 53 meta mark set meta mark | 0x00200000
	}

	chain dns_redirect {
		type nat hook prerouting priority -101; policy accept;
		iifname "br-lan" meta nfproto ipv4 meta l4proto { tcp, udp } th dport 53 redirect to :53
	}

	chain forward_guard {
		type filter hook forward priority -5; policy accept;
		iifname "br-lan" meta nfproto ipv6 reject with icmpv6 type admin-prohibited
		iifname "br-lan" ip daddr @local4 return
		iifname "br-lan" meta l4proto { tcp, udp } th dport 853 reject with icmpx type admin-prohibited
		iifname "br-lan" ip daddr @static4 oifname != "awgvpn" reject with icmpx type admin-prohibited
		iifname "br-lan" ip daddr @dns4 oifname != "awgvpn" reject with icmpx type admin-prohibited
	}

	chain output_guard {
		type filter hook output priority -5; policy accept;
		ip daddr { 9.9.9.9, 149.112.112.112 } meta l4proto { tcp, udp } th dport 53 oifname != "awgvpn" reject with icmpx type admin-prohibited
	}
}
