#!/bin/sh

set -e
umask 077

data=/usr/share/ra80-vpn
backup=
applying=0

fail() {
	printf '%s\n' "$1" >&2
	exit 1
}

on_exit() {
	local result=$?
	if [ "$result" -ne 0 ] && [ "$applying" = 1 ]; then
		printf 'Activation incomplete; any installed traffic guards remain in place. Original configuration: %s\n' "$backup" >&2
	fi
}

trap on_exit EXIT

valid_ipv4() {
	printf '%s\n' "$1" | awk -F. 'NF != 4 { exit 1 } { for (i=1; i<=4; i++) if ($i !~ /^[0-9]+$/ || $i > 255) exit 1 }'
}

check_peer() {
	local section="$1" disabled key endpoint allowed routes
	config_get_bool disabled "$section" disabled 0
	[ "$disabled" = 0 ] || return 0
	peer_count=$((peer_count + 1))
	config_get key "$section" public_key
	[ "${#key}" = 44 ] || fail 'An enabled peer needs a valid public key.'
	config_get endpoint "$section" endpoint_host
	valid_ipv4 "$endpoint" || fail 'Use a numeric IPv4 VPN endpoint to avoid a tunnel DNS dependency.'
	case "$endpoint" in
		9.9.9.9|149.112.112.112) fail 'The VPN endpoint conflicts with the dedicated DNS resolvers.' ;;
	esac
	config_get allowed "$section" allowed_ips
	case " $allowed " in
		*' 0.0.0.0/0 '*) ;;
		*) fail 'The VPN peer must allow 0.0.0.0/0; routing remains selective.' ;;
	esac
	config_get_bool routes "$section" route_allowed_ips 0
	[ "$routes" = 0 ] || fail 'Disable automatic allowed-IP routes on the VPN peer.'
}

check() {
	local package key address addresses section has_ipv4=0
	[ "$(uci -q get ra80_vpn.config.configured)" = 0 ] || fail 'Selective routing is already configured.'
	[ "$(uci -q get network.awgvpn.proto)" = amneziawg ] || fail 'Create an AmneziaWG interface named awgvpn with a separate private peer first.'
	[ "$(uci -q get network.lan.device)" = br-lan ] || fail 'This policy requires the LAN bridge br-lan.'
	[ "$(uci -q get network.wan)" = interface ] || fail 'This policy requires a direct WAN interface named wan.'
	[ "$(uci -q get dhcp.@dnsmasq[0])" = dnsmasq ] || fail 'A default dnsmasq instance is required.'
	[ -z "$(uci -q get dhcp.@dnsmasq[1])" ] || fail 'Multiple dnsmasq instances require a separate routing review.'
	[ "$(uci -q get dhcp.lan)" = dhcp ] || fail 'A LAN DHCP section is required.'
	[ "$(uci -q get firewall.@defaults[0])" = defaults ] || fail 'A firewall defaults section is required.'
	dnsmasq --version | grep -Eq '(^|[[:space:]])nftset([[:space:]]|$)' || fail 'dnsmasq-full with nftset support is required.'
	[ "$(uci -q get pbr.config.enabled)" != 1 ] || fail 'Disable the existing PBR service before configuring this policy.'
	for package in network firewall dhcp ra80_vpn; do
		[ -z "$(uci -q changes "$package")" ] || fail "Commit or discard pending $package changes first."
	done
	for section in network.ra80_vpn_route network.ra80_vpn_rule network.ra80_vpn_sink firewall.ra80_vpn_zone firewall.ra80_vpn_forward dhcp.ra80_vpn_domains; do
		[ -z "$(uci -q get "$section")" ] || fail "Configuration section $section is already in use."
	done
	[ -z "$(ip -4 route show table 200 2>/dev/null)" ] || fail 'Routing table 200 is already in use.'
	if ip -4 rule show | grep -Eq '^(30010|30011):|lookup 200([[:space:]]|$)|fwmark 0x200000'; then
		fail 'The reserved routing priorities or mark are already in use.'
	fi
	if nft list table inet ra80vpn >/dev/null 2>&1; then
		fail 'The ra80vpn nftables table already exists; inspect the previous activation first.'
	fi
	if uci -q show firewall | grep -Eq "\\.network=.*[' ]awgvpn([' ]|$)"; then
		fail 'Remove the existing firewall zone assignment for awgvpn before using this policy.'
	fi
	key="$(uci -q get network.awgvpn.private_key || true)"
	[ "${#key}" = 44 ] || fail 'The VPN interface private key is missing or invalid.'
	printf '%s\n' "$key" | awg pubkey >/dev/null || fail 'The VPN interface private key is invalid.'
	addresses="$(uci -q get network.awgvpn.addresses || true)"
	for address in $addresses; do
		valid_ipv4 "${address%/*}" && has_ipv4=1
	done
	[ "$has_ipv4" = 1 ] || fail 'The VPN interface needs its assigned IPv4 tunnel address.'
	. /lib/functions.sh
	peer_count=0
	config_load network
	config_foreach check_peer amneziawg_awgvpn
	[ "$peer_count" = 1 ] || fail 'Exactly one enabled AmneziaWG peer is required.'
	[ -s "$data/ipv4.txt" ] && [ -s "$data/domains.txt" ] || fail 'The destination lists are missing.'
	printf '%s\n' 'Configuration checks passed; no network changes were made.'
}

install_rules() {
	local rules
	nft list table inet ra80vpn >/dev/null 2>&1 && return 0
	rules="$(mktemp /tmp/ra80-vpn-rules.XXXXXX)"
	cat "$data/rules.nft" > "$rules"
	awk 'BEGIN { printf "add element inet ra80vpn static4 { " } NF { printf "%s%s", separator, $0; separator=", " } END { print " }" }' "$data/ipv4.txt" >> "$rules"
	nft -c -f "$rules"
	nft -f "$rules"
	rm -f "$rules"
}

staged() {
	uci -c "$stage/config" -t "$stage/delta" "$@"
}

enable() {
	local stage package domain
	check
	backup="/etc/ra80-vpn/backup-$(date +%s)"
	[ ! -e "$backup" ] || fail 'A configuration backup already exists for this second.'
	mkdir -p "$backup"
	stage="$(mktemp -d /tmp/ra80-vpn-config.XXXXXX)"
	mkdir "$stage/config" "$stage/delta"
	for package in network firewall dhcp ra80_vpn; do
		cp "/etc/config/$package" "$backup/$package"
		cp "/etc/config/$package" "$stage/config/$package"
	done
	staged -q delete 'dhcp.@dnsmasq[0].server' || true
	staged batch <<'UCI'
set network.awgvpn.auto='1'
set network.awgvpn.defaultroute='0'
set network.awgvpn.peerdns='0'
set network.awgvpn.fwmark='0'
set network.awgvpn.ip4table='200'
set network.awgvpn.tunlink='wan'
set network.ra80_vpn_route=route
set network.ra80_vpn_route.interface='awgvpn'
set network.ra80_vpn_route.target='0.0.0.0/0'
set network.ra80_vpn_route.table='200'
set network.ra80_vpn_rule=rule
set network.ra80_vpn_rule.mark='0x00200000/0x00200000'
set network.ra80_vpn_rule.priority='30010'
set network.ra80_vpn_rule.lookup='200'
set network.ra80_vpn_sink=rule
set network.ra80_vpn_sink.mark='0x00200000/0x00200000'
set network.ra80_vpn_sink.priority='30011'
set network.ra80_vpn_sink.action='unreachable'
set firewall.@defaults[0].flow_offloading='0'
set firewall.@defaults[0].flow_offloading_hw='0'
set firewall.ra80_vpn_zone=zone
set firewall.ra80_vpn_zone.name='ra80vpn'
add_list firewall.ra80_vpn_zone.network='awgvpn'
set firewall.ra80_vpn_zone.input='REJECT'
set firewall.ra80_vpn_zone.output='ACCEPT'
set firewall.ra80_vpn_zone.forward='REJECT'
set firewall.ra80_vpn_zone.masq='1'
set firewall.ra80_vpn_zone.mtu_fix='1'
set firewall.ra80_vpn_forward=forwarding
set firewall.ra80_vpn_forward.src='lan'
set firewall.ra80_vpn_forward.dest='ra80vpn'
set dhcp.@dnsmasq[0].noresolv='1'
set dhcp.@dnsmasq[0].filter_aaaa='1'
add_list dhcp.@dnsmasq[0].server='9.9.9.9'
add_list dhcp.@dnsmasq[0].server='149.112.112.112'
set dhcp.lan.ra='disabled'
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ndp='disabled'
set dhcp.ra80_vpn_domains=ipset
add_list dhcp.ra80_vpn_domains.name='dns4'
set dhcp.ra80_vpn_domains.table='ra80vpn'
set dhcp.ra80_vpn_domains.table_family='inet'
set dhcp.ra80_vpn_domains.family='4'
set ra80_vpn.config.configured='1'
UCI
	while IFS= read -r domain; do
		case "$domain" in
			''|*[!a-z0-9.-]*) fail 'The domain list contains an invalid entry.' ;;
		esac
		staged add_list "dhcp.ra80_vpn_domains.domain=$domain"
	done < "$data/domains.txt"
	for package in network firewall dhcp ra80_vpn; do
		staged commit "$package"
	done
	applying=1
	install_rules
	for package in network firewall dhcp ra80_vpn; do
		cp "$stage/config/$package" "/etc/config/$package"
	done
	/etc/init.d/ra80-vpn enable
	/etc/init.d/network reload
	/etc/init.d/firewall reload
	/etc/init.d/dnsmasq restart
	/etc/init.d/odhcpd restart
	ifup awgvpn
	applying=0
	printf 'Selective routing configured; verify the VPN handshake and client traffic. Original configuration: %s\n' "$backup"
	printf '%s\n' 'IPv6 forwarding is blocked, port 53 uses the router, and port 853 is blocked. Disable browser/app secure DNS to use the domain policy; arbitrary HTTPS DNS cannot be intercepted.'
}

case "${1:-check}" in
	check) check ;;
	enable) enable ;;
	load)
		[ "$(uci -q get ra80_vpn.config.configured)" = 1 ] || exit 0
		install_rules
		;;
	status)
		printf 'Configured: %s\n' "$(uci -q get ra80_vpn.config.configured)"
		ip -4 rule show
		ip -4 route show table 200
		nft list table inet ra80vpn
		awg show awgvpn latest-handshakes
		;;
	*) fail 'Usage: ra80-vpn {check|enable|load|status}' ;;
esac
